# Root-level shared config. Each service has its own .env.example — copy those individually.
# This file exists to document cross-service secrets at a glance.

# Supabase (one project, shared by frontend + core service)
SUPABASE_URL=
SUPABASE_ANON_KEY=          # frontend uses this
SUPABASE_SERVICE_ROLE_KEY=  # core service only — NEVER expose to frontend

# Claude API
ANTHROPIC_API_KEY=

# n8n webhook base (where n8n listens, core calls back here for WhatsApp sends)
N8N_BASE_URL=

# Meta Graph API (phase 5, for social posting)
META_APP_ID=
META_APP_SECRET=
