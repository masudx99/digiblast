# --- Core service ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Supabase (phase 1+) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_CARDS_BUCKET=generated-cards
SUPABASE_STORAGE_PHOTOS_BUCKET=player-photos

# --- Scraper (phase 2+) ---
SCRAPE_MIN_DELAY_MS=3000
SCRAPE_MAX_DELAY_MS=7000
SCRAPE_MAX_RETRIES=3
SCRAPE_FAILURES_DIR=./failures

# --- Claude API (phase 4+) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Test fixtures (local only) ---
